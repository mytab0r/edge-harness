{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // /api/* всегда уходит в воркер (и дальше в Durable Object), остальное — статика.
    // На Free run_worker_first превращает эти запросы из «бесплатной статики» в биллящиеся,
    // поэтому маска осознанно узкая — только API. См. docs/research/20-cloudflare-free.md
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HARNESS",
        "class_name": "Harness"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Harness"]
    }
  ],
  "vars": {
    // Чей репозиторий дёргать repository_dispatch'ем. Не секрет: репозиторий публичный.
    "GH_REPO": "mytab0r/edge-harness"
  }
  // Секреты (в конфиге не живут; переустанавливаются при каждом деплое
  // workflow'ом deploy-worker из секретов репозитория):
  //   HANDS_TOKEN        — разделяемый секрет: job ходит Bearer'ом, браузер обменивает
  //                        его на сессионную куку (POST /api/session); в URL не ходит
  //   GH_DISPATCH_TOKEN  — GitHub PAT с Contents:write, DO дёргает repository_dispatch
  //   SESSION_SECRET     — HMAC-ключ подписи сессионной куки браузера (issue #5);
  //                        вращение мгновенно разлогинивает все открытые сессии
}
