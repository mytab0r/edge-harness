{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // /api/* всегда уходит в воркер (и дальше в Durable Object), остальное — статика.
    // На Free run_worker_first превращает эти запросы из «бесплатной статики» в биллящиеся,
    // поэтому маска осознанно узкая — только API. См. docs/research/20-cloudflare-free.md
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HARNESS",
        "class_name": "Harness"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Harness"]
    }
  ],
  // Cron Trigger (issue #693): внешние часы, не зависящие от активности alarm()
  // самого DO — единственный ДРУГОЙ владелец Cron Triggers на этом аккаунте —
  // dsh-edge, у него `crons` в конфиге деплоя (.github/workflows/deploy-dsh-edge.yml)
  // не заведены вовсе, весь бюджет (5 триггеров/аккаунт, docs/research/20-
  // cloudflare-free.md, «Cron Triggers на Free») свободен. Интервал 5 мин, а не
  // =HEARTBEAT.selfOrchestrationMs (10 мин, issue #812 понизил с 15 — см.
  // обоснование числом в docstring HEARTBEAT, cf-worker/src/config.ts) —
  // обоснование числом в docstring scheduledTick() (cf-worker/src/harness.ts):
  // порог "alarm подвис" — 2×10=20 мин (pulseStale), 5-минутный тик cron
  // гарантирует наихудшее время починки не больше 25 минут (было 35 при
  // 15-минутном alarm, до #812) вне зависимости от внешнего трафика к DO —
  // сам инцидент 2026-09-07 (issue #693), который эта мера чинит, длился
  // НЕОГРАНИЧЕННО (нет трафика — alarm не восстанавливается вовсе, см.
  // проблему в теле #693); 25 минут не совпадают с его фактической
  // длительностью, это верхняя граница новой, ограниченной сверху версии
  // того же простоя. 288 тиков/сутки, requests
  // с огромным запасом (Free — 100 000/сутки);
  // по здоровому alarm'у тик не пишет ни одной строки (только чтение pulse) —
  // суточной квоты rows_written (100 000) касается лишь тогда, когда alarm
  // реально подвис, и тогда это те же ≤1 запись/тик, что и у самого alarm().
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Чей репозиторий дёргать repository_dispatch'ем. Не секрет: репозиторий публичный.
    "GH_REPO": "mytab0r/edge-harness"
  }
  // Секреты (в конфиге не живут; переустанавливаются при каждом деплое
  // workflow'ом deploy-worker из секретов репозитория):
  //   HANDS_TOKEN        — разделяемый секрет: job ходит Bearer'ом, браузер обменивает
  //                        его на сессионную куку (POST /api/session); в URL не ходит
  //   GH_DISPATCH_TOKEN  — узкий fine-grained GitHub PAT (Contents+Actions RW только
  //                        на этот репозиторий, задача #6/ADR 0008): DO дёргает
  //                        repository_dispatch задач, workflow_dispatch пульса и
  //                        repository_dispatch директив инбокса (event_type
  //                        inbox-issue → .github/workflows/inbox-issue.yml, ADR
  //                        0015 — issue создаёт job штатным github.token, без
  //                        отдельного секрета GH_ISSUES_TOKEN)
  //   SESSION_SECRET     — HMAC-ключ подписи сессионной куки браузера (issue #5);
  //                        вращение мгновенно разлогинивает все открытые сессии
  //   TELEGRAM_BOT_TOKEN — тот же секрет репозитория, что уже держит pulse_guard.py
  //                        (исходящие алерты); синхронизируется отдельно в морду,
  //                        чтобы она сама отвечала на нажатие инлайн-кнопки
  //                        (answerCallbackQuery/editMessageText, #254); не задан —
  //                        callback_query честно логируется, деплой не блокируется
  //   TELEGRAM_WEBHOOK_SECRET — секрет вебхука (Telegram setWebhook(secret_token=…)),
  //                        которым владелец включает приём апдейтов; без него
  //                        вебхук-путь для callback_query закрыт наглухо
  //   TELEGRAM_CHAT_ID   — тот же секрет репозитория, что уже держит pulse_guard.py
  //                        (исходящие алерты); привязка вебхука к владельцу (находка
  //                        ревью PR #486, ADR 0014 шаг 1): секрет вебхука
  //                        аутентифицирует бота, не отправителя — без сверки chat_id
  //                        морда примет апдейт из ЛЮБОГО чата бота. Не задан —
  //                        вебхук-путь (message И callback_query) закрыт наглухо,
  //                        тем же приёмом, что TELEGRAM_WEBHOOK_SECRET
}
