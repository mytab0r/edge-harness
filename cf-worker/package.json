    "canary": "node scripts/canary-ui.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.0",
    "ws": "^8.18.0"
  }
}
