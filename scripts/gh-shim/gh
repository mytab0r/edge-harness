#!/usr/bin/env bash
# PATH-шим `gh` для среды воркера (#594). Живой инцидент: PR #586 открыт
# голым `gh pr create` с «Closes #575» в обход единственной двери
# scripts/git/pr-create (#496, docs/agents/PROTOCOL.md п.7) — агент DSH
# headless вызывает `gh` сам изнутри своей сессии, инструкция в промпте его
# не удержала. Постфактумная проверка (scripts/orchestra/contract_check.py)
# поймала это уже ПОСЛЕ того, как PR был открыт: метка contract:failed,
# потраченный прогон, ручное вмешательство. Ограничение задокументировано
# как осознанное (openspec/changes/input-schema-not-output-parsing/
# design.md:205-217): транспорт DSH не даёт перехватить тул-колл агента
# изнутри сессии — единственный рычаг снаружи агента остаётся окружение
# процесса, который DSH запускает (PATH, env), не сам агент.
#
# Установка — scripts/lib/gh_shim.sh::gh_shim_install, единственный вызывающий
# — scripts/worker/task.sh (аренда среды: только процесс автономного
# воркера, не локальные машины и не hands/ai-review — там `gh pr create`
# агент не вызывает).
#
# ПРОЗРАЧНОСТЬ (обязательное требование): любая подкоманда, КРОМЕ буквально
# `gh pr create ...` первыми двумя позиционными аргументами ПОСЛЕ глобальных
# флагов gh (`-R/--repo`, `-H/--hostname` — раздельно, через `=` или
# прилепленным значением), уходит в настоящий gh БЕЗ изменений — код возврата,
# stdout, stderr, stdin (exec, не суб-шелл с перехватом потоков). Это
# единственная ветка логики, которую этот файл вообще решает; остальное —
# забота настоящего gh.
#
# ГЛОБАЛЬНЫЕ ФЛАГИ ПЕРЕД ПОДКОМАНДОЙ (находка ревью PR #596, GLM): gh
# принимает `-R o/r`/`--repo o/r`/`--hostname h` ДО имени подкоманды —
# `gh -R o/r pr create ...` доходил до настоящего gh в обход шима, который
# сравнивал только $1/$2. Ниже сначала пропускаются такие флаги (с их
# значением), и только первые ДВЕ оставшиеся позиционные лексемы сравниваются
# с `pr create`, независимо от того, сколько глобальных флагов им
# предшествовало. Круг 3 того же ревью: значение может быть ПРИЛЕПЛЕНО к
# короткому флагу без пробела и без `=` — `gh -R=o/r pr create ...` и
# `gh -Ro/r pr create ...` gh 2.100.0 принимает так же, а шим их не узнавал;
# в case добавлены `-R=*|-H=*` и `-R?*|-H?*` (прилепленному значению
# отдельной лексемы нет — пропускать только сам флаг), точные `-R/--repo`
# стоят первыми, иначе прилепленные формы съели бы и голый `-R`.
#
# ОТКАЗ, А НЕ РЕДИРЕКТ: `gh pr create` целиком (не только с Closes/Fixes/
# Resolves) отклоняется ДО какого-либо сетевого вызова — protocol.md п.7
# требует именно scripts/git/pr-create, никогда не голый `gh pr create`, а
# не только «тело без запрещённых слов». Отказ дешевле редиректа: не нужно
# протаскивать доверенный путь до scripts/git/pr-create через worktree'ы
# доводки PR (#476 — trust-zone, ветка PR не доверена), не нужно повторно
# транслировать аргументы — агент получает понятную инструкцию и сам
# вызывает дверь (как и предписывает промпт, scripts/worker/task.sh:370).
# Дверь под шимом РАБОТАЕТ: scripts/git/pr-create зовёт настоящий gh через
# "${GH_SHIM_REAL_GH:-gh}" — та же переменная, то же одно место правды, — а не
# голое слово `gh`, которое PATH вернул бы обратно в этот шим (петля «шим
# отсылает к двери, дверь отклоняется тем же шимом» — живая находка ревью
# PR #596, закрыта случаем «дверь под шимом» в gh-shim.test.sh).
# contract_check.py (постфактум) НЕ снят — это вход, defense-in-depth.
#
# `gh pr edit --body` — ВТОРОЙ вход того же класса (находка ревью PR #596,
# GLM): агент может открыть PR чистым телом через дверь, а затем дописать
# «Closes #N» правкой уже открытого PR. Это ОСОЗНАННО не перехвачено здесь —
# `gh pr edit` уходит в настоящий gh прозрачно, как и любая подкоманда, кроме
# `pr create`. Единственная граница для этого пути — contract_check.py:
# `orchestra.yml` гоняет его и на `pull_request.types: edited`, читая тело PR
# заново через API при каждой правке, а не только при открытии — тот же
# постфактумный слой, что и для `pr create`, не второй механизм. Решение
# явное: вход перед сетью есть только у `pr create` (единственная дверь,
# #496); для `pr edit` действует исключительно постфактумная проверка. Третья
# осознанно непокрытая форма — `gh api -X POST repos/<owner>/<repo>/pulls …`
# (находка ревью PR #596): подкоманда `api` прозрачна по построению, а PR ею
# создаётся тем же REST-вызовом мимо двери; единственная граница и для неё —
# постфактумный contract_check.py, читающий открытые PR через API.
#
# БЕЗ РЕКУРСИИ: GH_SHIM_REAL_GH — абсолютный путь настоящего gh, вычисленный
# gh_shim_install() ДО того, как PATH получил каталог этого шима (`type -P
# gh` на чистом PATH — именно type -P, не command -v: в смок-среде
# dsh-clients.smoke.sh command -v нашёл бы функцию-заглушку gh(), а не файл,
# см. gh_shim.sh). Если переменная не задана или не исполняема — это
# ПОЛОМКА установки (не «шима нет вовсе»): молча звать первый попавшийся `gh`
# из PATH означало бы риск вызвать самого себя (бесконечная рекурсия) или
# тихо снять защиту — fail loud вместо этого.
set -euo pipefail

if [ -z "${GH_SHIM_REAL_GH:-}" ] || [ ! -x "${GH_SHIM_REAL_GH:-}" ]; then
  echo "::error::gh-shim: GH_SHIM_REAL_GH не задан или не исполняем (\"${GH_SHIM_REAL_GH:-<пусто>}\") — установка шима сломана (см. scripts/lib/gh_shim.sh::gh_shim_install), а не «шима нет»: чинить установку, не игнорировать" >&2
  exit 127
fi

# Пропускаем ведущие глобальные флаги gh (с их значением), чтобы найти
# первые две ПОДКОМАНДНЫЕ лексемы независимо от того, сколько флагов вида
# `-R o/r`/`--repo=o/r`/`-R=o/r`/`-Ro/r`/`-H h`/`-H=h`/`-Hh` стоит перед ними.
sub1=""
sub2=""
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" = "1" ]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    # Точные флаги со значением СЛЕДУЮЩЕЙ лексемой — первыми: иначе формы
    # `-R=*`/`-R?*` ниже съели бы и голый `-R`, оставив его значение первой
    # позиционной лексемой («pr» никогда не совпало бы).
    -R|--repo|-H|--hostname)
      skip_next=1
      continue
      ;;
    # Значение, прилепленное к флагу (`--repo=o/r`, `-R=o/r`, `-Ro/r`,
    # `-Hh`, …): отдельной лексемы-значения нет — пропускать только сам флаг
    # (находка ревью PR #596, круг 3: `-R=o/r pr create` и `-Ro/r pr create`
    # gh 2.100.0 принимает и они доходили до настоящего gh в обход шима).
    --repo=*|--hostname=*|-R=*|-H=*|-R?*|-H?*)
      continue
      ;;
  esac
  if [ -z "$sub1" ]; then
    sub1="$arg"
  elif [ -z "$sub2" ]; then
    sub2="$arg"
    break
  fi
done

if [ "$sub1" = "pr" ] && [ "$sub2" = "create" ]; then
  echo "::error::gh pr create запрещён напрямую в этом окружении — единственная дверь: scripts/git/pr-create --base main --head <ветка> --title \"…\" --body-file <файл> (тот же интерфейс, что gh pr create, issue #496). Она проверяет тело ДО отправки, а не постфактум." >&2
  exit 1
fi

exec "$GH_SHIM_REAL_GH" "$@"
