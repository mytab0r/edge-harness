#!/usr/bin/env bash
# Канонический вход в задачу — единственный способ создать agent-ветку.
#
# Почему: оркестратор сливает PR на сервере, и локальный origin/main протухает
# молча. Ветка, созданная «по памяти» от старого base, превращается в потерянные
# часы (реальный случай: старый workflow воскрес в рабочем дереве, 2026-08-30).
# Здесь свежесть базы доказывается, а не предполагается:
#   1) fetch + авторитетная сверка ls-remote — тихо упавший fetch base не выдаёт;
#   2) самовосстановление core.hooksPath — гвардия свежести обязательна всегда.
#
# Использование: scripts/git/task-branch <номер>-<slug>
set -euo pipefail

task="${1:-}"
if [ -z "$task" ] || printf '%s' "$task" | grep -qE '[^A-Za-z0-9._-]'; then
  echo "Использование: $0 <номер>-<slug>   (например: $0 61-my-feature)" >&2
  exit 1
fi

git fetch origin --prune

# ls-remote идёт мимо локальных ссылок: если после fetch локальный origin/main
# не равен серверному — сеть/прокси врут, работать на таком base нельзя.
remote_head=$(git ls-remote origin refs/heads/main | cut -f1)
local_head=$(git rev-parse refs/remotes/origin/main)
if [ "$remote_head" != "$local_head" ]; then
  echo "ОШИБКА: origin/main протух даже после fetch (локально $local_head, на сервере $remote_head)." >&2
  echo "Разберись с сетью/прокси — протухший base не выдаю." >&2
  exit 1
fi

# Аренда задачи (#121, ADR 0006) — до сих пор её брал только облачный воркер
# (scripts/worker/task.sh); внешние агенты создавали ветку в обход claim, и
# free_task() (scripts/worker/task.sh) считал такую задачу свободной — облачный
# воркер мог взять работу, которую прямо сейчас делает внешний агент (#356).
# Ветка создаётся только этим скриптом — забыть аренду здесь стало невозможно.
# Тот же вход, что у воркера/hands (lease_cli, scripts/lib/lease.sh) — второй
# путь claim'а не заводим.
#
# LEASE_ALREADY_CLAIMED=<номер> — транспорт (task.sh, dsh_task.sh) арендует
# задачу раньше (до старта агента, ради дешёвого fail-fast) и пробрасывает
# НОМЕР арендованной задачи сюда через окружение процесса-агента: без него
# второй claim того же номера тем же держателем отклонился бы как «занято»
# (claim не идемпотентен по актору) и валил бы штатный путь транспорта.
#
# Флаг несёт номер, а не булев признак. Булев признак был дырой (#356-фоллоуап,
# найдено ревью): за один прогон агент может создать ВТОРУЮ ветку на ДРУГУЮ
# задачу (playbook это допускает, например для сопутствующей задачи) — с
# булевым флагом task-branch молча пропускал бы аренду второй задачи, приняв
# чужую (первую) аренду за свою. Здесь claim пропускается, только когда номер
# во флаге совпадает с номером ветки; иначе аренда берётся как обычно — это и
# есть правильное поведение для второй задачи.
#
# Замок канало-агностичен по дизайну (#121: refs/locks/task-N не хранит, кто
# именно держит замок, кроме свободного текста коммита) — все каналы работают
# под одним логином, поэтому «идемпотентный claim по держателю» здесь опасен:
# он не отличил бы «этот же прогон уже взял это же N» от «другой прогон под
# тем же логином только что взял то же N» и тихо съел бы настоящую гонку,
# которую и защищает замок. Явный номер во флаге такой путаницы не создаёт.
task_num=$(printf '%s' "$task" | grep -oE '^[0-9]+' || true)
lease_claimed="${LEASE_ALREADY_CLAIMED:-}"

if [ -n "$lease_claimed" ] && ! printf '%s' "$lease_claimed" | grep -qE '^[0-9]+$'; then
  echo "ОШИБКА: LEASE_ALREADY_CLAIMED=«$lease_claimed» — не номер задачи. Транспорт обязан передавать номер арендованной задачи (например LEASE_ALREADY_CLAIMED=356), не булев флаг «1»/«true» — почини producer, не глотай проверку." >&2
  exit 1
fi

if [ -n "$lease_claimed" ] && [ -n "$task_num" ] && [ "$lease_claimed" = "$task_num" ]; then
  echo "Аренда уже взята транспортом для #$task_num (LEASE_ALREADY_CLAIMED=$lease_claimed) — task-branch её не повторяет."
else
  if [ -n "$lease_claimed" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: LEASE_ALREADY_CLAIMED=$lease_claimed относится не к этой ветке (задача #${task_num:-?}) — арендую #${task_num:-?} отдельно, как будто флага не было." >&2
  fi
  if [ -z "$task_num" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: «$task» не начинается с номера задачи — аренда пропущена (branch без claim)." >&2
  elif ! command -v gh >/dev/null 2>&1; then
    echo "ПРЕДУПРЕЖДЕНИЕ: gh недоступен (офлайн?) — аренда задачи #$task_num пропущена, ветка создаётся без неё." >&2
  else
    # GITHUB_REPOSITORY: в CI уже задан; локально берём тем же способом, что
    # scripts/review/file_tasks.py::current_repo — gh repo view.
    repo="${GITHUB_REPOSITORY:-}"
    if [ -z "$repo" ]; then
      repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
    fi
    if [ -z "$repo" ]; then
      echo "ПРЕДУПРЕЖДЕНИЕ: не удалось определить репозиторий (gh repo view, офлайн?) — аренда #$task_num пропущена." >&2
    else
      export GITHUB_REPOSITORY="$repo"
      export CLAIM_VIA="${CLAIM_VIA:-task-branch (local)}"
      source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/lease.sh"
      claim_out="$(lease_cli claim "$task_num" 2>&1)" && claim_rc=0 || claim_rc=$?
      if [ "$claim_rc" -eq 1 ]; then
        echo "ОШИБКА: задача #$task_num уже арендована другим исполнителем: $claim_out" >&2
        echo "  Кто держит: assignee и комментарий 🔒 в issue #$task_num (там канал и время аренды)." >&2
        echo "  Что делать: возьми другую свободную задачу — ветка не создаётся." >&2
        exit 1
      elif [ "$claim_rc" -ne 0 ]; then
        echo "ПРЕДУПРЕЖДЕНИЕ: claim_task сломался (rc=$claim_rc) — аренда #$task_num пропущена, ветка создаётся без неё: $claim_out" >&2
      else
        echo "Аренда взята: $claim_out"
      fi
    fi
  fi
fi

git switch -c "agent/$task" refs/remotes/origin/main

# Гвардия свежести ставится каждым запуском: пересозданный клон защищён сразу.
git config core.hooksPath .githooks

echo "Ветка agent/$task от origin/main $(git rev-parse --short origin/main) ($(git log -1 --format=%cd --date=iso origin/main))"
