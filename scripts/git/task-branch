#!/usr/bin/env bash
# Канонический вход в задачу — единственный способ создать agent-ветку.
#
# Почему: оркестратор сливает PR на сервере, и локальный origin/main протухает
# молча. Ветка, созданная «по памяти» от старого base, превращается в потерянные
# часы (реальный случай: старый workflow воскрес в рабочем дереве, 2026-08-30).
# Здесь свежесть базы доказывается, а не предполагается:
#   1) fetch + авторитетная сверка ls-remote — тихо упавший fetch base не выдаёт;
#   2) самовосстановление core.hooksPath — гвардия свежести обязательна всегда.
#
# Использование: scripts/git/task-branch <номер>-<slug>
set -euo pipefail

task="${1:-}"
if [ -z "$task" ] || printf '%s' "$task" | grep -qE '[^A-Za-z0-9._-]'; then
  echo "Использование: $0 <номер>-<slug>   (например: $0 61-my-feature)" >&2
  exit 1
fi

# Проверка на входе, не гвардия постфактум: задача обязана существовать, быть
# открытой, нести метку task и НЕ нести blocked — иначе ветка заводится под
# то, чего уже нет/чем нельзя заниматься, и это обнаруживается только ПОСЛЕ
# работы (тот же класс живого случая #320/#325: приёмка закрыла задачу, пока
# по ней был открыт второй PR — contract упал уже после того, как работа
# сделана). gh недоступен (офлайн/не установлен/сеть не отвечает) — только
# предупреждение: у агента без сети нет способа спросить GitHub вообще, а
# отказ создавать ветку в таком случае обошёлся бы дороже непроверенной ветки.
task_number="${task%%-*}"
if ! printf '%s' "$task_number" | grep -qE '^[0-9]+$'; then
  echo "ПРЕДУПРЕЖДЕНИЕ: не смог извлечь номер задачи из «$task» (ожидается N-slug) — проверка GitHub пропущена." >&2
elif ! command -v gh >/dev/null 2>&1; then
  echo "ПРЕДУПРЕЖДЕНИЕ: gh не найден — задача #$task_number не проверена (открыта/метки), ветка заводится непроверенной." >&2
else
  # git config --get (не `git remote get-url`, который резолвит url.*.insteadOf
  # и отдал бы уже переписанный адрес) — сырой сконфигурированный URL origin.
  origin_url=$(git config --get remote.origin.url 2>/dev/null || true)
  # Только срез схемы+хоста регэкспом (ERE не умеет ленивый +?: (.+?) жадно
  # проглатывает .git, и (\.git)? матчит пустоту — суффикс не срезался,
  # gh api видел «o/r.git» и 404-ил на реальных клонах). Суффикс .git снимается
  # отдельно точным суффиксом shell-параметра, а не регэкспом.
  repo=$(printf '%s' "$origin_url" | sed -E 's#^(git@|https://)[^:/]+[:/]##')
  repo="${repo%.git}"
  if [ -z "$repo" ] || [ "$repo" = "$origin_url" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: не смог определить owner/repo из origin ($origin_url) — задача #$task_number не проверена." >&2
  else
    err_file=$(mktemp)
    info=$(gh api "repos/$repo/issues/$task_number" \
      --jq '[.state, (.labels // [] | map(.name) | join(","))] | @tsv' 2>"$err_file") && rc=0 || rc=$?
    err=$(cat "$err_file"); rm -f "$err_file"
    if [ "$rc" -ne 0 ]; then
      if printf '%s' "$err" | grep -qE 'HTTP 404'; then
        echo "ОШИБКА: задача #$task_number не найдена в $repo — ветку не завожу." >&2
        exit 1
      fi
      echo "ПРЕДУПРЕЖДЕНИЕ: задача #$task_number не проверена (gh/сеть: $err) — ветка заводится непроверенной." >&2
    else
      state=$(printf '%s' "$info" | cut -f1)
      labels=",$(printf '%s' "$info" | cut -f2),"
      if [ "$state" != "open" ]; then
        echo "ОШИБКА: задача #$task_number закрыта — ветку не завожу." >&2
        exit 1
      fi
      case "$labels" in
        *,task,*) : ;;
        *) echo "ОШИБКА: на задаче #$task_number нет метки task — это не задача пула, ветку не завожу." >&2; exit 1 ;;
      esac
      case "$labels" in
        *,blocked,*)
          echo "ОШИБКА: на задаче #$task_number метка blocked — она ждёт владельца, ветку не завожу." >&2
          exit 1
          ;;
      esac
    fi
  fi
fi

git fetch origin --prune

# ls-remote идёт мимо локальных ссылок: если после fetch локальный origin/main
# не равен серверному — сеть/прокси врут, работать на таком base нельзя.
remote_head=$(git ls-remote origin refs/heads/main | cut -f1)
local_head=$(git rev-parse refs/remotes/origin/main)
if [ "$remote_head" != "$local_head" ]; then
  echo "ОШИБКА: origin/main протух даже после fetch (локально $local_head, на сервере $remote_head)." >&2
  echo "Разберись с сетью/прокси — протухший base не выдаю." >&2
  exit 1
fi

# Гвардия «PR не заводится на эпик» (#376): ветка на эпик не сходится по
# определению — критерий приёмки эпика распределён по нескольким стройкам,
# недостижим в одном PR, каждый раунд ревью законно находит новое (класс
# воспроизведён живьём: PR #162, 44 раунда ревью на ветку, привязанную к
# эпику #77, вместо узкой задачи на одну стройку). Признак эпика —
# is_epic_issue (scripts/orchestra/scheduler.py, PR #342) — одно место
# правды, копия не заводится; обёртка scripts/lib/epic_guard.py. Номер
# извлекается из "$task" тем же способом (^[0-9]+), что и остальные точки
# входа задачи; нечисловой префикс не поддержан этим входом — проверка
# пропускается, а не выдумывает номер. Офлайн-режима у входа в задачу нет
# (proposal.md): сбой сети/gh при проверке эпика тоже громкий, не тихий
# пропуск — поэтому здесь нет `command -v python3`/`command -v gh`, только
# сам вызов; отсутствие интерпретатора роняет `set -e` сам, отсутствие gh
# эпик_guard.py ловит и превращает в чистый EXIT_ERROR (не traceback).
epic_task_num=$(printf '%s' "$task" | grep -oE '^[0-9]+' || true)
if [ -n "$epic_task_num" ]; then
  if ! python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/epic_guard.py" "$epic_task_num"; then
    exit 1
  fi
fi

git switch -c "agent/$task" refs/remotes/origin/main

# Гвардия свежести ставится каждым запуском: пересозданный клон защищён сразу.
git config core.hooksPath .githooks

echo "Ветка agent/$task от origin/main $(git rev-parse --short origin/main) ($(git log -1 --format=%cd --date=iso origin/main))"
