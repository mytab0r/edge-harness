#!/usr/bin/env bash
# Канонический вход в задачу — единственный способ создать agent-ветку.
#
# Почему: оркестратор сливает PR на сервере, и локальный origin/main протухает
# молча. Ветка, созданная «по памяти» от старого base, превращается в потерянные
# часы (реальный случай: старый workflow воскрес в рабочем дереве, 2026-08-30).
# Здесь свежесть базы доказывается, а не предполагается:
#   1) fetch + авторитетная сверка ls-remote — тихо упавший fetch base не выдаёт;
#   2) самовосстановление core.hooksPath — гвардия свежести обязательна всегда.
#
# Использование: scripts/git/task-branch <номер>-<slug>
set -euo pipefail

task="${1:-}"
if [ -z "$task" ] || printf '%s' "$task" | grep -qE '[^A-Za-z0-9._-]'; then
  echo "Использование: $0 <номер>-<slug>   (например: $0 61-my-feature)" >&2
  exit 1
fi

# Проверка на входе, не гвардия постфактум: задача обязана существовать, быть
# открытой, нести метку task и НЕ нести blocked — иначе ветка заводится под
# то, чего уже нет/чем нельзя заниматься, и это обнаруживается только ПОСЛЕ
# работы (тот же класс живого случая #320/#325: приёмка закрыла задачу, пока
# по ней был открыт второй PR — contract упал уже после того, как работа
# сделана). gh недоступен (офлайн/не установлен/сеть не отвечает) для ЭТОЙ,
# первой проверки (открыта/метки) — только предупреждение: у агента без сети
# нет способа спросить GitHub вообще, а отказ здесь обошёлся бы дороже
# непроверенной ветки. НО (находка ревью PR #386, второй раунд: этот абзац
# разошёлся с кодом ниже по гвардии эпика) мягкая политика на этом не
# распространяется дальше — гвардия «PR не заводится на эпик» (#376,
# `scripts/lib/epic_guard.py`) считает офлайн-режим/сбой gh громким отказом
# входа целиком (proposal.md этого change), поэтому итоговый вход при
# недоступном gh СЕЙЧАС отказывает, а не заводит непроверенную ветку — см.
# ниже, после `git fetch origin --prune`.
task_number="${task%%-*}"
if ! printf '%s' "$task_number" | grep -qE '^[0-9]+$'; then
  echo "ПРЕДУПРЕЖДЕНИЕ: не смог извлечь номер задачи из «$task» (ожидается N-slug) — проверка GitHub пропущена." >&2
elif ! command -v gh >/dev/null 2>&1; then
  echo "ПРЕДУПРЕЖДЕНИЕ: gh не найден — задача #$task_number не проверена (открыта/метки), ветка заводится непроверенной." >&2
else
  # git config --get (не `git remote get-url`, который резолвит url.*.insteadOf
  # и отдал бы уже переписанный адрес) — сырой сконфигурированный URL origin.
  origin_url=$(git config --get remote.origin.url 2>/dev/null || true)
  # Только срез схемы+хоста регэкспом (ERE не умеет ленивый +?: (.+?) жадно
  # проглатывает .git, и (\.git)? матчит пустоту — суффикс не срезался,
  # gh api видел «o/r.git» и 404-ил на реальных клонах). Суффикс .git снимается
  # отдельно точным суффиксом shell-параметра, а не регэкспом.
  repo=$(printf '%s' "$origin_url" | sed -E 's#^(git@|https://)[^:/]+[:/]##')
  repo="${repo%.git}"
  if [ -z "$repo" ] || [ "$repo" = "$origin_url" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: не смог определить owner/repo из origin ($origin_url) — задача #$task_number не проверена." >&2
  else
    err_file=$(mktemp)
    info=$(gh api "repos/$repo/issues/$task_number" \
      --jq '[.state, (.labels // [] | map(.name) | join(","))] | @tsv' 2>"$err_file") && rc=0 || rc=$?
    err=$(cat "$err_file"); rm -f "$err_file"
    if [ "$rc" -ne 0 ]; then
      if printf '%s' "$err" | grep -qE 'HTTP 404'; then
        echo "ОШИБКА: задача #$task_number не найдена в $repo — ветку не завожу." >&2
        exit 1
      fi
      echo "ПРЕДУПРЕЖДЕНИЕ: задача #$task_number не проверена (gh/сеть: $err) — ветка заводится непроверенной." >&2
    else
      state=$(printf '%s' "$info" | cut -f1)
      labels=",$(printf '%s' "$info" | cut -f2),"
      if [ "$state" != "open" ]; then
        echo "ОШИБКА: задача #$task_number закрыта — ветку не завожу." >&2
        exit 1
      fi
      case "$labels" in
        *,task,*) : ;;
        *) echo "ОШИБКА: на задаче #$task_number нет метки task — это не задача пула, ветку не завожу." >&2; exit 1 ;;
      esac
      case "$labels" in
        *,blocked,*)
          echo "ОШИБКА: на задаче #$task_number метка blocked — она ждёт владельца, ветку не завожу." >&2
          exit 1
          ;;
      esac
    fi
  fi
fi

git fetch origin --prune

# ls-remote идёт мимо локальных ссылок: если после fetch локальный origin/main
# не равен серверному — сеть врёт, работать на таком base нельзя.
remote_head=$(git ls-remote origin refs/heads/main | cut -f1)
local_head=$(git rev-parse refs/remotes/origin/main)
if [ "$remote_head" != "$local_head" ]; then
  echo "ОШИБКА: origin/main протух даже после fetch (локально $local_head, на сервере $remote_head)." >&2
  echo "Разберись с сетью — протухший base не выдаю." >&2
  exit 1
fi

# Гвардия «PR не заводится на эпик» (#376): ветка на эпик не сходится по
# определению — критерий приёмки эпика распределён по нескольким стройкам,
# недостижим в одном PR, каждый раунд ревью законно находит новое (класс
# воспроизведён живьём: PR #162, 44 раунда ревью на ветку, привязанную к
# эпику #77, вместо узкой задачи на одну стройку). Признак эпика —
# is_epic_issue (scripts/orchestra/scheduler.py, PR #342) — одно место
# правды, копия не заводится; обёртка scripts/lib/epic_guard.py. Номер
# извлекается из "$task" тем же способом (^[0-9]+), что и остальные точки
# входа задачи; нечисловой префикс не поддержан этим входом — проверка
# пропускается, а не выдумывает номер. Офлайн-режима у входа в задачу нет
# (proposal.md): сбой сети/gh при проверке эпика тоже громкий, не тихий
# пропуск — поэтому здесь нет `command -v python3`/`command -v gh`, только
# сам вызов; отсутствие интерпретатора роняет `set -e` сам, отсутствие gh
# эпик_guard.py ловит и превращает в чистый EXIT_ERROR (не traceback).
epic_task_num=$(printf '%s' "$task" | grep -oE '^[0-9]+' || true)
if [ -n "$epic_task_num" ]; then
  if ! python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/epic_guard.py" "$epic_task_num"; then
    exit 1
  fi
fi

# Аренда задачи (#121, ADR 0006) — до сих пор её брал только облачный воркер
# (scripts/worker/task.sh); внешние агенты создавали ветку в обход claim, и
# free_task() (scripts/worker/task.sh) считал такую задачу свободной — облачный
# воркер мог взять работу, которую прямо сейчас делает внешний агент (#356).
# Ветка создаётся только этим скриптом — забыть аренду здесь стало невозможно.
# Тот же вход, что у воркера/hands (lease_cli, scripts/lib/lease.sh) — второй
# путь claim'а не заводим.
#
# LEASE_ALREADY_CLAIMED=<номер> — транспорт (task.sh, dsh_task.sh) арендует
# задачу раньше (до старта агента, ради дешёвого fail-fast) и пробрасывает
# НОМЕР арендованной задачи сюда через окружение процесса-агента: без него
# второй claim того же номера тем же держателем отклонился бы как «занято»
# (claim не идемпотентен по актору) и валил бы штатный путь транспорта.
#
# Флаг несёт номер, а не булев признак. Булев признак был дырой (#356-фоллоуап,
# найдено ревью): за один прогон агент может создать ВТОРУЮ ветку на ДРУГУЮ
# задачу (playbook это допускает, например для сопутствующей задачи) — с
# булевым флагом task-branch молча пропускал бы аренду второй задачи, приняв
# чужую (первую) аренду за свою. Здесь claim пропускается, только когда номер
# во флаге совпадает с номером ветки; иначе аренда берётся как обычно — это и
# есть правильное поведение для второй задачи.
#
# Замок канало-агностичен по дизайну (#121: refs/locks/task-N не хранит, кто
# именно держит замок, кроме свободного текста коммита) — все каналы работают
# под одним логином, поэтому «идемпотентный claim по держателю» здесь опасен:
# он не отличил бы «этот же прогон уже взял это же N» от «другой прогон под
# тем же логином только что взял то же N» и тихо съел бы настоящую гонку,
# которую и защищает замок. Явный номер во флаге такой путаницы не создаёт.
# Находка ревью PR #360: раньше здесь заново вычислялся `task_num` более
# мягким регэкспом (`grep -oE '^[0-9]+'` на всей строке `$task`), чем уже
# провалидированный выше `task_number` (`${task%%-*}` + строгие `^[0-9]+$`,
# строка 29) — на входе вроде `61.a-slug` проверка GitHub (строки 29-70
# выше) пропускалась с предупреждением (task_number="61.a" не проходит
# `^[0-9]+$`), а аренда всё равно ставилась на "61" — другое значение, не
# то, что не прошло проверку. Переиспользуем `task_number` и ЕГО ЖЕ критерий
# валидности — если он не прошёл, аренда пропускается тем же путём, что и
# проверка GitHub, вместо тихой подмены на более короткое число.
task_num="$task_number"
if ! printf '%s' "$task_num" | grep -qE '^[0-9]+$'; then
  task_num=""
fi
lease_claimed="${LEASE_ALREADY_CLAIMED:-}"

if [ -n "$lease_claimed" ] && ! printf '%s' "$lease_claimed" | grep -qE '^[0-9]+$'; then
  echo "ОШИБКА: LEASE_ALREADY_CLAIMED=«$lease_claimed» — не номер задачи. Транспорт обязан передавать номер арендованной задачи (например LEASE_ALREADY_CLAIMED=356), не булев флаг «1»/«true» — почини producer, не глотай проверку." >&2
  exit 1
fi

if [ -n "$lease_claimed" ] && [ -n "$task_num" ] && [ "$lease_claimed" = "$task_num" ]; then
  echo "Аренда уже взята транспортом для #$task_num (LEASE_ALREADY_CLAIMED=$lease_claimed) — task-branch её не повторяет."
else
  if [ -n "$lease_claimed" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: LEASE_ALREADY_CLAIMED=$lease_claimed относится не к этой ветке (задача #${task_num:-?}) — арендую #${task_num:-?} отдельно, как будто флага не было." >&2
  fi
  if [ -z "$task_num" ]; then
    echo "ПРЕДУПРЕЖДЕНИЕ: «$task» не начинается с номера задачи — аренда пропущена (branch без claim)." >&2
  elif ! command -v gh >/dev/null 2>&1; then
    echo "ПРЕДУПРЕЖДЕНИЕ: gh недоступен (офлайн?) — аренда задачи #$task_num пропущена, ветка создаётся без неё." >&2
  else
    # GITHUB_REPOSITORY: в CI уже задан; локально берём тем же способом, что
    # scripts/review/file_tasks.py::current_repo — gh repo view.
    repo="${GITHUB_REPOSITORY:-}"
    if [ -z "$repo" ]; then
      repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
    fi
    if [ -z "$repo" ]; then
      echo "ПРЕДУПРЕЖДЕНИЕ: не удалось определить репозиторий (gh repo view, офлайн?) — аренда #$task_num пропущена." >&2
    else
      export GITHUB_REPOSITORY="$repo"
      export CLAIM_VIA="${CLAIM_VIA:-task-branch (local)}"
      source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/lease.sh"
      claim_out="$(lease_cli claim "$task_num" 2>&1)" && claim_rc=0 || claim_rc=$?
      if [ "$claim_rc" -eq 1 ]; then
        echo "ОШИБКА: задача #$task_num уже арендована другим исполнителем: $claim_out" >&2
        echo "  Кто держит: assignee и комментарий 🔒 в issue #$task_num (там канал и время аренды)." >&2
        echo "  Что делать: возьми другую свободную задачу — ветка не создаётся." >&2
        exit 1
      elif [ "$claim_rc" -ne 0 ]; then
        echo "ПРЕДУПРЕЖДЕНИЕ: claim_task сломался (rc=$claim_rc) — аренда #$task_num пропущена, ветка создаётся без неё: $claim_out" >&2
      else
        echo "Аренда взята: $claim_out"
      fi
    fi
  fi
fi

git switch -c "agent/$task" refs/remotes/origin/main

# Гвардия свежести ставится каждым запуском: пересозданный клон защищён сразу.
git config core.hooksPath .githooks

echo "Ветка agent/$task от origin/main $(git rev-parse --short origin/main) ($(git log -1 --format=%cd --date=iso origin/main))"

# Печать ключевых граблей инфраструктуры в момент старта задачи, а не когда-нибудь
# потом «если вспомнить прочитать» (задача #323): task-branch — один из ДВУХ
# входов в agent-ветку (второй — доводка уже открытого PR в scripts/worker/task.sh,
# он тоже зовёт print_infra_digest напрямую, минуя этот файл, — см. #326 находка 1).
# Текст — одно место правды в scripts/gh/infra_digest.sh, не копия здесь.
source "$(dirname "${BASH_SOURCE[0]}")/../gh/infra_digest.sh"
print_infra_digest
