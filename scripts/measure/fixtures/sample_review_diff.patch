# Реалистичный фикстур-промпт для замера латентности (issue #836, ревью
# #837): реальный дифф из истории ЭТОГО репозитория (коммит 0c1d6864, PR
# #591), не придуманный текст и не "hi" — гейт ai-review ревьюит диффы
# такого размера/формы, и латентность решает порядок цепочки именно на них,
# не на коротких промптах. Секретов/токенов в диффе нет — он публичный (сам
# файл и коммит уже в истории репозитория). ~1500-2000 токенов текста.

diff --git a/scripts/git/pr-create b/scripts/git/pr-create
index 378a56bb..97fad171 100755
--- a/scripts/git/pr-create
+++ b/scripts/git/pr-create
@@ -24,13 +24,25 @@
 #
 # Использование: то же самое, что `gh pr create` — все аргументы
 # проксируются без изменений (--title, --body/--body-file, --base, --head, …).
+#
+# Тело не задано НИ ОДНИМ способом (нет --body/--body-file/--fill*/--editor/
+# --recover) — `gh pr create` в неинтерактивной среде (агент/CI, без TTY) на
+# это не подставляет `.github/PULL_REQUEST_TEMPLATE.md` сам (флаг `--template`
+# у gh — это только стартовый текст интерактивного промпта/редактора, здесь
+# его нет), а без него молча просит `--title`/`--body` заново или падает.
+# Явное требование задачи: шаблон обязан реально применяться в этом случае —
+# обёртка сама подставляет `--body-file .github/PULL_REQUEST_TEMPLATE.md`,
+# тот же файл, что видит человек через веб-форму GitHub.
 set -euo pipefail
 
 SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+TEMPLATE_FILE="$REPO_ROOT/.github/PULL_REQUEST_TEMPLATE.md"
 
 body=""
 args=()
 tmp_body_file=""
+has_body_source=false
 n=$#
 i=1
 while [ "$i" -le "$n" ]; do
@@ -40,16 +52,19 @@ while [ "$i" -le "$n" ]; do
       i=$((i + 1))
       val="${!i}"
       body="$val"
+      has_body_source=true
       args+=("--body" "$val")
       ;;
     --body=*)
       val="${arg#--body=}"
       body="$val"
+      has_body_source=true
       args+=("$arg")
       ;;
     --body-file)
       i=$((i + 1))
       file="${!i}"
+      has_body_source=true
       if [ "$file" = "-" ]; then
         tmp_body_file="$(mktemp)"
         cat >"$tmp_body_file"
@@ -62,6 +77,7 @@ while [ "$i" -le "$n" ]; do
       ;;
     --body-file=*)
       file="${arg#--body-file=}"
+      has_body_source=true
       if [ "$file" = "-" ]; then
         tmp_body_file="$(mktemp)"
         cat >"$tmp_body_file"
@@ -72,6 +88,22 @@ while [ "$i" -le "$n" ]; do
         args+=("$arg")
       fi
       ;;
+    --fill|-f|--fill-first|--fill-verbose|--editor|-e)
+      # gh сам соберёт тело (из коммитов или редактора) — шаблон здесь не
+      # подставляем поверх, это осознанный выбор вызывающего.
+      has_body_source=true
+      args+=("$arg")
+      ;;
+    --recover)
+      i=$((i + 1))
+      val="${!i}"
+      has_body_source=true
+      args+=("--recover" "$val")
+      ;;
+    --recover=*)
+      has_body_source=true
+      args+=("$arg")
+      ;;
     *)
       args+=("$arg")
       ;;
@@ -79,6 +111,14 @@ while [ "$i" -le "$n" ]; do
   i=$((i + 1))
 done
 
+if [ "$has_body_source" = false ]; then
+  if [ -f "$TEMPLATE_FILE" ]; then
+    echo "::notice::Тело PR не задано — подставляю .github/PULL_REQUEST_TEMPLATE.md (заполни разделы и первую строку #N перед мержем)." >&2
+    body="$(cat "$TEMPLATE_FILE")"
+    args+=("--body-file" "$TEMPLATE_FILE")
+  fi
+fi
+
 if [ -n "$body" ]; then
   # Один и тот же вызов, что contract_check.py — не второй regex рядом.
   py_check='
diff --git a/scripts/git/test/pr-create-guard.test.sh b/scripts/git/test/pr-create-guard.test.sh
index 159919ac..95a786ff 100755
--- a/scripts/git/test/pr-create-guard.test.sh
+++ b/scripts/git/test/pr-create-guard.test.sh
@@ -106,4 +106,45 @@ else
   note "OK случай 6: директива внутри inline-кода не триггерит отказ (семантика #423/#429)"
 fi
 
+# ── случай 7: тело не задано вовсе — подставляется .github/PULL_REQUEST_
+# TEMPLATE.md (агент физически не может открыть PR с пустым телом мимо
+# шаблона) ─────────────────────────────────────────────────────────────────
+rm -f "$MARKER"
+ARGS_FILE="$WORK/gh-args"
+cat >"$WORK/bin/gh" <<GHEOF
+#!/usr/bin/env bash
+if [ "\$1" = "pr" ] && [ "\$2" = "create" ]; then
+  echo called >"$MARKER"
+  printf '%s\n' "\$@" >"$ARGS_FILE"
+  echo "https://github.com/o/r/pull/1"
+  exit 0
+fi
+echo "unexpected gh call: \$*" >&2
+exit 1
+GHEOF
+chmod +x "$WORK/bin/gh"
+if ! bash "$SCRIPT_SRC" --title t >"$WORK/out7" 2>"$WORK/err7"; then
+  note "FAIL случай 7: без --body/--body-file pr-create отказал вовсе"; cat "$WORK/err7"; fail=1
+elif [ ! -f "$MARKER" ]; then
+  note "FAIL случай 7: gh не вызван без --body/--body-file"; fail=1
+elif ! grep -qF "$REPO_ROOT/.github/PULL_REQUEST_TEMPLATE.md" "$ARGS_FILE"; then
+  note "FAIL случай 7: gh вызван без --body-file на шаблон"; cat "$ARGS_FILE"; fail=1
+elif ! grep -q "PULL_REQUEST_TEMPLATE.md" "$WORK/err7"; then
+  note "FAIL случай 7: нет уведомления о подстановке шаблона"; fail=1
+else
+  note "OK случай 7: пустое тело подставляет .github/PULL_REQUEST_TEMPLATE.md"
+fi
+
+# ── случай 8: --fill не подставляет шаблон поверх (осознанный выбор gh) ──────
+rm -f "$MARKER" "$ARGS_FILE"
+if ! bash "$SCRIPT_SRC" --title t --fill >"$WORK/out8" 2>"$WORK/err8"; then
+  note "FAIL случай 8: --fill отклонён"; cat "$WORK/err8"; fail=1
+elif [ ! -f "$MARKER" ]; then
+  note "FAIL случай 8: gh не вызван с --fill"; fail=1
+elif grep -qF "PULL_REQUEST_TEMPLATE.md" "$ARGS_FILE"; then
+  note "FAIL случай 8: шаблон подставлен поверх --fill"; cat "$ARGS_FILE"; fail=1
+else
+  note "OK случай 8: --fill не подменяется шаблоном"
+fi
+
 exit "$fail"
