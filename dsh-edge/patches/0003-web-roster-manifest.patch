+/**
+ * Client roster entries contributed by the edge-harness plugin manifest
+ * (standalone/edge-plugins.json, generated from dsh-edge/plugins.json).
+ * The file is optional: without it (or with an empty list) the roster is
+ * exactly the upstream one. A present manifest entry is LOUD: unlike the
+ * upstream declared-package loop below, a manifest plugin that is missing
+ * from node_modules or lacks a web dsh.client declaration must fail the
+ * build, not silently skip the roster row.
+ */
+async function manifestClientEntries() {
+  let raw
+  try {
+    raw = await readFile(edgePluginsManifestPath, 'utf8')
+  } catch (error) {
+    if (error?.code === 'ENOENT') return []
+    throw error
+  }
+  const parsed = JSON.parse(raw)
+  if (!Array.isArray(parsed)) {
+    throw new Error('standalone/edge-plugins.json must be an array of { id, package } entries.')
+  }
+  for (const entry of parsed) {
+    if (typeof entry?.id !== 'string' || entry.id === '' || typeof entry?.package !== 'string' || entry.package === '') {
+      throw new Error(`standalone/edge-plugins.json entry must carry non-empty id and package strings: ${JSON.stringify(entry)}`)
+    }
+  }
+  return parsed
+}
 
