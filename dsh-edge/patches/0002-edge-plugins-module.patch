+
+  /**
+   * Install the owner plugins declared by the generated composition module
+   * (edge-plugins.generated.ts, produced from the edge-harness plugin
+   * manifest). Isolation follows the upstream precedent of the LLM provider
+   * plugin above: a failing plugin must not take the Durable Object down —
+   * it fails loudly (console + DO storage status) and the loop continues in
+   * manifest order.
+   */
+  private async installEdgePlugins(storage: DurableObjectStorage): Promise<void> {
+    for (const entry of edgePlugins) {
+      try {
+        await this.context.plugin(entry.plugin as never)
+        await storage.put(`dsh-edge-plugins:${entry.id}`, { status: 'ready' })
+        console.info(`edge-plugin:${entry.id} installed`)
+      } catch (error) {
+        console.error(`edge-plugin:${entry.id} failed to install; it stays disabled for this deployment.`, error)
+        try {
+          await storage.put(`dsh-edge-plugins:${entry.id}`, {
+            status: 'failed',
+            detail: error instanceof Error ? error.message : String(error),
+          })
+        } catch (storageError) {
+          // Статус — метаданные; их запись не должна пробить изоляцию плагина.
+          console.error(`edge-plugin:${entry.id} failed to record its install status.`, storageError)
+        }
+      }
+    }
   }
 
