+  /**
+   * Ingest one harness runner transcript batch into an existing session (#119).
+   * Runner jobs drive their own DSH process outside this deployment and mirror
+   * the canonical events they produced into a viewer session, so the owner reads
+   * the run in the native UI. Ingest never runs the agent. The mapping is the
+   * minimum that keeps the stored log canonical — turn numbers continue the
+   * stored log (a reused session never rewinds), surface events join at the
+   * tail — and the whole batch flushes before this returns, so a batch reported
+   * as stored is stored. Publication reuses the store's late-event path: live
+   * downlinks see ingested events exactly like native ones.
+   */
+  async appendHarnessEvents(
+    id: SessionId,
+    events: readonly unknown[],
+  ): Promise<{ appended: number; lastSeq: number }> {
+    const { persistence, sessions } = await this.services()
+    if (!(persistence instanceof DurableObjectSessionPersistence)) {
+      throw new EdgeSessionStoreError('INVALID_DATA', 'Edge persistence backend is unavailable.')
+    }
+    if (!persistence.hasSession(id) && persistence.readBlankSession(id) === undefined) {
+      throw new EdgeSessionStoreError('NOT_FOUND', 'Session not found.')
+    }
+    const handle = await this.openAgentForTurn(id, DEFAULT_EDGE_MODEL)
+    try {
+      const session = handle.agent.session
+      let baseTurn = 0
+      for (const event of session.events) {
+        const turn = (event.data as { turn?: unknown }).turn
+        if (typeof turn === 'number' && Number.isSafeInteger(turn) && turn > baseTurn) baseTurn = turn
+      }
+      let appended = 0
+      for (const raw of events) {
+        const normalized = normalizeHarnessIngestEvent(raw, baseTurn)
+        // Runtime-dynamic event type: the generic append overload cannot express
+        // it, so the call site carries the narrow cast (opts only for surface).
+        // bind() обязателен: append читает приватное состояние сессии через this.
+        const append = session.append.bind(session) as unknown as (
+          type: string,
+          data: unknown,
+          opts?: { surfaceOp: 'append' },
+        ) => SessionEvent
+        append(normalized.type, normalized.data, normalized.surface ? { surfaceOp: 'append' } : undefined)
+        appended += 1
+      }
+      await sessions.flush(session)
+      return { appended, lastSeq: session.seq - 1 }
+    } finally {
+      await handle.dispose().catch((disposeError: unknown) => {
+        console.error('dsh-edge failed to release the ingested session.', disposeError)
+      })
+    }
+  }
