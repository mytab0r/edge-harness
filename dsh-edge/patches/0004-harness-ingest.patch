+/** Canonical event types harness ingest accepts — the runner spool allowlist. */
+const HARNESS_INGEST_EVENT_TYPES = new Set([
+  'turn/start', 'turn/end', 'step/start', 'step/end',
+  'user/message', 'assistant/message', 'tool/call', 'tool/result',
+])
+/** Ingest events carrying a turn number, renumbered onto the stored log. */
+const HARNESS_TURNED_EVENT_TYPES = new Set([
+  'turn/start', 'turn/end', 'step/start', 'step/end',
+  'assistant/message', 'tool/call', 'tool/result',
+])
+/** Ingest events on the model-visible surface: they join the surface at the tail. */
+const HARNESS_SURFACE_EVENT_TYPES = new Set(['user/message', 'assistant/message', 'tool/result'])
+
+/**
+ * Validate one runner-side canonical event and renumber its turn. An unknown
+ * type or malformed payload is a loud 400, never a silent skip: a runner upgrade
+ * must not write an unreviewed event vocabulary into the owner's log.
+ */
+function normalizeHarnessIngestEvent(
+  raw: unknown,
+  baseTurn: number,
+): { type: string; data: Record<string, unknown>; surface: boolean } {
+  const fail = (message: string): EdgeSessionStoreError =>
+    new EdgeSessionStoreError('INVALID_DATA', `Harness ingest rejected: ${message}`)
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) throw fail('event must be an object')
+  const { type, data: source } = raw as { type?: unknown; data?: unknown }
+  if (typeof type !== 'string' || !HARNESS_INGEST_EVENT_TYPES.has(type)) {
+    throw fail(`unknown event type ${JSON.stringify(type ?? null)}`)
+  }
+  if (source === null || typeof source !== 'object' || Array.isArray(source)) {
+    throw fail(`"${type}" data must be an object`)
+  }
+  const data: Record<string, unknown> = { ...(source as Record<string, unknown>) }
+  const isInt = (value: unknown): value is number =>
+    typeof value === 'number' && Number.isSafeInteger(value) && value >= 0
+  if (HARNESS_TURNED_EVENT_TYPES.has(type)) {
+    if (!isInt(data.turn)) throw fail(`"${type}" requires a non-negative integer turn`)
+    data.turn = (data.turn as number) + baseTurn
+    if (type !== 'turn/start' && type !== 'turn/end' && !isInt(data.step)) {
+      throw fail(`"${type}" requires a non-negative integer step`)
+    }
+  }
+  if (type === 'turn/end') {
+    const reason = data.reason
+    if (reason === null || typeof reason !== 'object' || Array.isArray(reason)
+      || typeof (reason as { kind?: unknown }).kind !== 'string') {
+      throw fail('"turn/end" requires a reason object with a kind')
+    }
+  }
+  if (type === 'user/message') {
+    const sourceField = data.source
+    if (data.role !== 'user' || !Array.isArray(data.content) || sourceField === null
+      || typeof sourceField !== 'object' || typeof (sourceField as { kind?: unknown }).kind !== 'string') {
+      throw fail('"user/message" requires role "user", content blocks, and a source')
+    }
+  }
+  if (type === 'assistant/message' || type === 'tool/result') {
+    const message = data.message
+    if (message === null || typeof message !== 'object' || Array.isArray(message)
+      || !Array.isArray((message as { content?: unknown }).content)) {
+      throw fail(`"${type}" requires a message object with content blocks`)
+    }
+  }
+  return { type, data, surface: HARNESS_SURFACE_EVENT_TYPES.has(type) }
+}
