+  /**
+   * HARNESS (#1379): состав карантина наружу, читаемый деплоем.
+   *
+   * Писатель этой таблицы — recordQuarantinedSessions выше (#1376). У списка
+   * было два читателя, и оба недоступны прогону деплоя: console.error уходит
+   * в Workers-логи (Logpush не подключён), а таблица живёт внутри Durable
+   * Object. То есть карантин работал, но узнать его состав можно было только
+   * руками. Метод — единственный способ прочитать состав снаружи DO.
+   *
+   * Таблицы может не быть вовсе: её создаёт recordQuarantinedSessions, а он
+   * зовётся только при миграции. Инстанс, который ни разу не мигрировал,
+   * карантина не имеет — это честный ПУСТОЙ список, а не отказ, поэтому
+   * отсутствие таблицы возвращает [], и различать «таблицы нет» и «карантин
+   * пуст» на этом уровне нечего: оба значат «ничего не изолировано».
+   * Обратное — ошибка чтения при СУЩЕСТВУЮЩЕЙ таблице — проглатываться не
+   * имеет права и уходит наверх исключением: «пусто» и «посмотреть не
+   * смогли» лечатся по-разному.
+   */
+  quarantinedSessions(): readonly QuarantinedSessionRecord[] {
+    const tableExists = this.storage.sql.exec<{ count: number }>(
+      `SELECT count(*) AS count FROM sqlite_master
+       WHERE type = 'table' AND name = 'dsh_edge_quarantined_sessions'`,
+    ).toArray()[0]?.count ?? 0
+    if (tableExists === 0) return []
+    return this.storage.sql.exec<QuarantinedSessionRecord>(
+      `SELECT id, stored_version AS storedVersion, reason, observed_at AS observedAt
+       FROM dsh_edge_quarantined_sessions ORDER BY id`,
+    ).toArray()
+  }
