node_modules/
dist/
.wrangler/
.dev.vars
*.log

# Секреты не живут в репозитории — только имена в документации.
.env
.env.*
!.env.example

__pycache__/
*.pyc

# Локальный кеш npm при установке зависимостей на раннере (не артефакт репо).
.npm-cache/

# Рабочие деревья агентов (#332/#333) — заводятся scripts/git/task-branch
# локально на диске, в историю репозитория не попадают (находка ревью #333:
# без этой строки `git add -A` в главном дереве затягивает их как embedded
# gitlink).
.claude/worktrees/
