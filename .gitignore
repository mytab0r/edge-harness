# Локальный venv для прогонов pytest на раннере (в job CI pytest ставится сам;
# в воркер-окружении pip без --user в систему не пишет — venv живёт в worktree).
.venv/

# Локальный кеш npm при установке зависимостей на раннере (не артефакт репо).
.npm-cache/
