#!/usr/bin/env bash
# Обязательный локальный гейт гвардий перед `git push` (issue #1280).
#
# Класс дефекта, повод: PR #893, коммит a14deb87ef2f05fd81566310482b57d6cff6218c
# — обязательный чек `test` покраснел на гвардии класса #749 за 13 минут ДО
# того, как ai-ревью написало о том же прозой. Механизм scripts/ci/guards/*.sh
# уже стоял и уже сработал бы здесь, если бы кто-то его спросил ДО пуша.
# Логика гейта (два режима, третье состояние, аварийный выход) — в докстринге
# scripts/lib/pre_push_guard_gate.py, здесь только вызов.
#
# Активируется через core.hooksPath=.githooks — ставит scripts/git/task-branch
# безусловно, и для автономного воркера (одноразовый CI-чекаут), и для
# локальных рабочих деревьев. Честная граница (см. proposal.md #1280): файл
# этого хука — обычный отслеживаемый файл репозитория, git ищет его в
# ТЕКУЩЕМ checkout — рабочее дерево, заведённое ДО появления этого коммита в
# main, этот файл на диске не увидит, пока не перебазируется на свежий
# origin/main. Это не новая дыра: тот же класс уже касается любого файла
# каталога гвардий, и обязательный серверный чек `test` (branch protection,
# читает состояние ветки, а не локальный git-хук) остаётся последней
# инстанцией независимо от возраста рабочего дерева.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

python_bin="python3"
command -v python3 >/dev/null 2>&1 || python_bin="python"

exec "$python_bin" "$repo_root/scripts/lib/pre_push_guard_gate.py"
