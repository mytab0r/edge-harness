#!/usr/bin/env bash
# Гвардия свежего base. main двигается на сервере (оркестратор сливает PR),
# локальная копия протухает молча — поэтому сверяемся ПЕРЕД каждым коммитом.
# Протух — коммит запрещён с инструкцией; тихо-устаревших коммитов не бывает.
#
# Активируется через core.hooksPath=.githooks (ставит scripts/git/task-branch;
# руками: git config core.hooksPath .githooks).
set -euo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "ПРЕДУПРЕЖДЕНИЕ: коммит прямо в main — в этом репо main меняется только через PR (docs/agents/PROTOCOL.md)." >&2
fi

# Гвардия «дерево == задача» (#332). Класс инцидента: агент по задаче #320
# правил файлы в дереве оркестратора (.claude/worktrees/pr-workflow-sessions-8f1ab5)
# на чужой ветке agent/258-...; в тот же день другой агент нашёл там же
# незакоммиченные диффы чужой ветки #297, а библиотекарь переключил главное
# дерево на свою ветку из-под работавшего там агента. Дисциплина «не путай
# деревья» не сработала трижды за сутки — здесь она enforced механически, а
# не по памяти. Правило: коммит в agent/<N>-<slug> разрешён ТОЛЬКО из
# рабочего дерева, чьё имя (basename top-level пути) начинается с того же
# числа <N>-. Проверка чисто локальная (без сети) — идёт раньше свежести
# base ниже, чтобы не ждать fetch там, где откажем и так.
#
# Исключение для CI (находка ревью #333): task-branch в режиме
# GITHUB_ACTIONS=true намеренно переключает ветку в одноразовом чекауте
# воркера, не заводя worktree (scripts/worker/task.sh уже сам изолирован на
# один прогон — см. комментарий там же). Без этого исключения гвардия
# отклоняет ПЕРВЫЙ же коммит автономного воркера в CI: каталог называется
# «edge-harness», а не «<N>-...», и правило падает не на инцидент #332
# (спутанные деревья агента/человека локально), а на штатный путь конвейера.
if [[ "$branch" =~ ^agent/([0-9]+)(-|$) ]] && [ "${GITHUB_ACTIONS:-}" != "true" ]; then
  task_num="${BASH_REMATCH[1]}"
  worktree_name=$(basename "$(git rev-parse --show-toplevel)")
  if [[ ! "$worktree_name" =~ ^${task_num}(-|$) ]]; then
    echo "ОШИБКА: ветка $branch — рабочее дерево этой задачи не здесь." >&2
    echo "  Текущее дерево: «$worktree_name» (имя должно начинаться с «$task_num-»)." >&2
    echo "  Не путай чужую ветку со своим деревом (класс #332)." >&2
    echo "  Заведи/найди дерево этой задачи:  scripts/git/task-branch $task_num-<slug>" >&2
    echo "  — команда напечатает путь; коммить оттуда." >&2
    exit 1
  fi
fi

if ! git rev-parse --verify -q refs/remotes/origin/main >/dev/null; then
  echo "ОШИБКА: нет refs/remotes/origin/main — сделай 'git fetch origin' и повтори." >&2
  exit 1
fi

git fetch origin main --quiet || {
  echo "ОШИБКА: не смог свериться с сервером (git fetch упал) — коммит заблокирован." >&2
  echo "Проверь сеть и повтори; коммит в обход проверки не оставляем." >&2
  exit 1
}

if ! git merge-base --is-ancestor refs/remotes/origin/main HEAD; then
  echo "ОШИБКА: main уехал вперёд (оркестратор слил PR-ы) — base протух." >&2
  echo "Обнови базу и повтори коммит:  git rebase origin/main" >&2
  echo "(или пересоздай ветку: scripts/git/task-branch <номер>-<slug>)" >&2
  exit 1
fi
